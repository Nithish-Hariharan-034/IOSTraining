// 13. Check Prime Number and Print Primes from 1 to 50
func main13() {
    let number = 17
    var isPrime = number >= 2

    if number >= 2 {
        for i in 2...Int(Double(number).squareRoot()) {
            if number % i == 0 {
                isPrime = false
                break
            }
        }
    }

    print(isPrime ? "Prime" : "Not prime")

    for n in 2...50 {
        var prime = true

        for i in 2...Int(Double(n).squareRoot()) {
            if n % i == 0 {
                prime = false
                break
            }
        }

        if prime {
            print(n)
        }
    }
}

// 14. Simple Calculator Using Switch
func main14() {
    let a = 20.0
    let b = 5.0
    let operation = "/"

    switch operation {
