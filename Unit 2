// 2.3 Find sum and average of an array.
func main23() {
    let numbers = [10, 20, 30, 40, 50]
    var sum = 0

    for number in numbers {
        sum += number
    }

    let average = Double(sum) / Double(numbers.count)

    print("Sum:", sum)
    print("Average:", average)
}

// 2.4 Find maximum and minimum without max() or min().
func main24() {
    let numbers = [15, 7, 28, 3, 19]

    var maximum = numbers[0]
    var minimum = numbers[0]

    for number in numbers {
        if number > maximum {
            maximum = number
        }

        if number < minimum {
            minimum = number
        }
    }

    print("Maximum:", maximum)
    print("Minimum:", minimum)
}

