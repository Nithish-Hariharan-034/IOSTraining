// 2.10 Remove duplicates while keeping original order.
func main210() {
    let numbers = [1, 2, 3, 2, 4, 1, 5, 3]
    var uniqueNumbers: [Int] = []

    for number in numbers {
        if !uniqueNumbers.contains(number) {
            uniqueNumbers.append(number)
        }
    }

    print(uniqueNumbers)
}

// 2.11 Sum of squares of even numbers from 1 to 20 using filter, map and reduce.
func main211() {
    let result = Array(1...20)
        .filter { $0 % 2 == 0 }
        .map { $0 * $0 }
        .reduce(0, +)

    print(result)
}

// 2.12 Union, intersection, subtracting and symmetric difference.
func main212() {
    let setA: Set<Int> = [1, 2, 3, 4, 5]
    let setB: Set<Int> = [4, 5, 6, 7, 8]

    print("Union:", setA.union(setB))
    print("Intersection:", setA.intersection(setB))
    print("Subtracting:", setA.subtracting(setB))
    print("Symmetric Difference:", setA.symmetricDifference(setB))
}

// 2.13 Count the frequency of each word in a sentence.
func main213() {
    let sentence = "to be or not to be"
    let words = sentence.split(separator: " ")
    var frequency: [String: Int] = [:]

    for word in words {
        frequency[String(word), default: 0] += 1
    }

    print(frequency)
}

// 2.14 Sort students by marks in descending order and print top 3.
