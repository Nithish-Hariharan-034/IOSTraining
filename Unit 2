// 2.15 Find the second largest distinct element.
func main215() {
    let numbers = [10, 25, 8, 40, 30, 40]
    var largest: Int?
    var secondLargest: Int?

    for number in numbers {
        if largest == nil || number > largest! {
            secondLargest = largest
            largest = number
        } else if number != largest! &&
                    (secondLargest == nil || number > secondLargest!) {
            secondLargest = number
        }
    }

    if let second = secondLargest {
        print(second)
    } else {
        print("No second largest element")
    }
}

// 2.16 Create a 3x3 matrix, print row by row and sum the diagonal.
