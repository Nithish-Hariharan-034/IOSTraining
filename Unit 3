// 3.10 BankAccount with Deposit and Withdraw
struct BankAccount {
    var balance: Double

    mutating func deposit(amount: Double) {
        if amount > 0 {
            balance += amount
        }
    }

    mutating func withdraw(amount: Double) {
        if amount > 0 && amount <= balance {
            balance -= amount
        } else {
            print("Insufficient balance or invalid amount")
        }
    }
}

func main310() {
    var account = BankAccount(balance: 1000)
    account.deposit(amount: 500)
    account.withdraw(amount: 200)
    print(account.balance)
}

// 3.11 Value Type vs Reference Type
struct ValueCounter {
    var value: Int
}

class ReferenceCounter {
    var value: Int

    init(value: Int) {
        self.value = value
    }
}

func main311() {
    var originalStruct = ValueCounter(value: 10)
    var copiedStruct = originalStruct
    copiedStruct.value = 20

    print(originalStruct.value)
    print(copiedStruct.value)

    let originalClass = ReferenceCounter(value: 10)
    let copiedClass = originalClass
    copiedClass.value = 20

    print(originalClass.value)
    print(copiedClass.value)

    // Structs are value types, so copies are independent.
    // Classes are reference types, so both variables refer to the same object.
}

